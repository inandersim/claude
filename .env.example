# Veri sağlayıcı: "mock" (yerel, çevrimdışı örnek veri) veya "remote" (gerçek API)
EXPO_PUBLIC_DATA_PROVIDER=mock
# remote sağlayıcı için API taban adresi
EXPO_PUBLIC_API_URL=https://api.zirtan.app
# Vektör karo sunucusu (PMTiles). Yerelde: node tools/tiles/serve.mjs --port 8090
# Tanımlıysa harita paketleri gerçekten indirilir ve harita karolardan çizilir.
EXPO_PUBLIC_TILES_URL=http://localhost:8090

# --------------------------------------------------------------------
# Supabase (gerçek veri sağlayıcısı) — src/data/remote
# İkisi de tanımlıysa uygulama gerçek sağlayıcıya bağlanır.
# EXPO_PUBLIC_DATA_PROVIDER=mock her zaman mock'ta kalmaya zorlar.
# --------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://<proje>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Yapay zekâ ağ geçidi (sohbet, görüntü analizi, tür tanımlama, triyaj).
# Tanımsızsa tüm modüller yerel (cihaz içi) yanıtlara düşer.
# EXPO_PUBLIC_AI_GATEWAY_URL=https://ai.zirtan.app
# EXPO_PUBLIC_AI_GATEWAY_KEY=<gateway-key>

# --------------------------------------------------------------------
# Sözleşme testleri (yalnızca geliştirme) — src/data/__tests__/contract
# Yerel Postgres+PostGIS: PGHOST=/tmp PGPORT=54329 PGUSER=postgres ./supabase/test/run.sh
# --------------------------------------------------------------------
# PGHOST=/tmp
# PGPORT=54329
# PGUSER=postgres
# ZIRTAN_TEST_DB=zirtan_test
# ZIRTAN_TEST_PG=1

# --------------------------------------------------------------------
# Medya CDN'i — kullanıcı fotoğrafları buradan okunur.
# Tanımsızsa görseller doğrudan Supabase Storage'dan gelir ve **çıkış
# faturalıdır**: ölçüm 100 bin kullanıcıda ~55 TB/ay, ~$4.900 (docs/SCALE.md).
# Cloudflare'de `cdn.<alan>.app` → Supabase Storage genel yolunu önbellekleyen
# bir kural yeterli; Cloudflare çıkışı ücretsiz.
# Adres yazımı çizim anında yapılır — kapatınca göç gerekmez.
# EXPO_PUBLIC_MEDIA_CDN_URL=https://cdn.zirtan.app

# Lansman kapsamı: "v1" dar kapsam, tanımsız/"full" tamamı (src/core/flags.ts).
# EXPO_PUBLIC_LAUNCH_SCOPE=full

# Bildirim: EAS proje kimliği (expo-notifications adres alırken kullanır).
# EXPO_PUBLIC_EAS_PROJECT_ID=
