{
  "expo": {
    "name": "Zirve",
    "slug": "zirve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zirve",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0B1210",
    "primaryColor": "#5EE39B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zirve.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki maceraperestleri bulmak ve rota önerileri sunmak için konumuna ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Macera fotoğraflarını paylaşabilmen için galerine erişmemiz gerekiyor.",
        "NSCameraUsageDescription": "Macera anlarını doğrudan fotoğraflayabilmen için kameraya erişmemiz gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zirve.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1210",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "zirve.app", "pathPrefix": "/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1210",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki maceraperestleri bulmak için konumuna ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Macera fotoğraflarını paylaşabilmen için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Macera anlarını fotoğraflayabilmen için kameraya erişmemiz gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
