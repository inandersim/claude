{
  "expo": {
    "name": "Zirtan",
    "slug": "zirtan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zirtan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#10201B",
    "primaryColor": "#5EE39B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zirtan.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki maceraperestleri bulmak ve rota önerileri sunmak için konumuna ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Macera fotoğraflarını paylaşabilmen için galerine erişmemiz gerekiyor.",
        "NSCameraUsageDescription": "Macera anlarını doğrudan fotoğraflayabilmen için kameraya erişmemiz gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Canlı yayında sesini iletebilmek için mikrofona erişmemiz gerekiyor."
      }
    },
    "android": {
      "package": "com.zirtan.app",
      "adaptiveIcon": {
        "backgroundColor": "#10201B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "zirtan.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10201B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki maceraperestleri bulmak için konumuna ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Macera fotoğraflarını paylaşabilmen için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Macera anlarını fotoğraflayabilmen için kameraya erişmemiz gerekiyor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Canlı yayın yapabilmen için kameraya erişmemiz gerekiyor.",
          "microphonePermission": "Canlı yayında sesini iletebilmek için mikrofona erişmemiz gerekiyor.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
