# Claude API anahtarı — yalnızca bu serviste bulunur, uygulamaya gömülmez
ANTHROPIC_API_KEY=sk-ant-...
# İstemcilerin x-zirtan-key başlığında göndereceği anahtarlar (virgülle ayrılmış)
ZIRVE_GATEWAY_KEYS=dev-key
PORT=8787
RATE_LIMIT_PER_MIN=30
CORS_ORIGIN=*
ZIRVE_AI_MODEL=claude-opus-5
ZIRVE_AI_MAX_TOKENS=16000
