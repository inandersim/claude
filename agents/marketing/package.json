{
  "name": "@zirtan/marketing-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Zirtan — Claude API tabanlı sıfır bütçeli pazarlama ajanları (plan, içerik üretimi, yanıt, analiz, yayınlama)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zirtan-marketing": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "cli": "node dist/src/cli.js",
    "plan": "node dist/src/cli.js plan",
    "generate": "node dist/src/cli.js generate",
    "reply": "node dist/src/cli.js reply",
    "analyze": "node dist/src/cli.js analyze",
    "post": "node dist/src/cli.js post"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
