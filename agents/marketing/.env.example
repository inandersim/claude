# Claude API anahtarı — SDK ortamdan okur (ANTHROPIC_API_KEY). Zorunlu: plan / generate / reply / analyze
ANTHROPIC_API_KEY=sk-ant-...
# İsteğe bağlı: model kimliğini ve üst token sınırını değiştirmek için
# MARKETING_MODEL=
# MARKETING_MAX_TOKENS=32000

# --- Yayınlama (post komutu) — hepsi isteğe bağlı, yalnızca ilgili kanal için gerekir ---
# Meta (Instagram Graph API + Facebook Sayfa). Uzun ömürlü kullanıcı ya da sayfa token'ı.
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
# VK: Standalone uygulama ile alınan kullanıcı token'ı (wall, photos, groups izinleri)
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Telegram: BotFather token'ı ve kanal kullanıcı adı (@zirtanapp) ya da sayısal chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@zirtanapp

# Gönderi linklerine eklenecek UTM kaynakları için temel URL
APP_LANDING_URL=https://zirtan.app

# --- Yeni kanallar (.mjs katmanı: dispatch / launch --live) ---
# X (Twitter): developer.x.com → Project & App → OAuth 2.0 / App-only Bearer token.
# Ücretsiz katman ayda ~1.500 gönderi yazma; okuma/metrik kapalı (metrikleri elle dışa aktar).
X_BEARER_TOKEN=
# Pinterest: developers.pinterest.com → App → OAuth (pins:write, boards:read). Pano kimliği v5 API'den.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# LinkedIn: Developer App → "Share on LinkedIn" + "Advertising API" (organik sayfa gönderisi için w_organization_social).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:0000000
# Reddit: reddit.com/prefs/apps → script app → OAuth token (submit kapsamı). Hesap 30 gün / 200 karma olmalı.
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=zirtanapp
# TikTok: Content Posting API yalnızca onaylı uygulamalarda; onaysız hesapta paket elle yüklenir.
TIKTOK_ACCESS_TOKEN=
# YouTube: Google Cloud → YouTube Data API v3 → OAuth (youtube.upload). Yükleme sürdürülebilir (resumable) akış ister.
YOUTUBE_ACCESS_TOKEN=

# Betiklerin çıktı klasörünü değiştirmek için (testlerde geçici klasör kullanılır)
# ZIRTAN_OUT_DIR=out
