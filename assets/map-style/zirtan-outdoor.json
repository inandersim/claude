      "id": "poi-spring",
      "type": "circle",
      "source": "@source",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "natural"
        ],
        "spring"
      ],
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          3,
          15,
          6
        ],
