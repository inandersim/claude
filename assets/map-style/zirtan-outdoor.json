      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "@trailTechnical",
        "line-dasharray": [
          1.6,
          1.1
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          10,
          1.1,
          13,
          2.6,
          16,
          5
        ]
      }
    },
    {
      "id": "trail-steps",
      "type": "line",
      "source": "@source",
      "source-layer": "trails",
      "minzoom": 12,
      "filter": [
        "==",
