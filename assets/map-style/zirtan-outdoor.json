      "type": "line",
      "source": "@source",
      "source-layer": "trails",
      "minzoom": 10,
      "filter": [
        "any",
        [
          "in",
          [
            "get",
            "sac_scale"
          ],
          [
            "literal",
            [
              "demanding_mountain_hiking",
              "alpine_hiking",
              "demanding_alpine_hiking",
              "difficult_alpine_hiking"
            ]
          ]
        ],
        [
          "==",
          [
            "get",
            "highway"
          ],
          "via_ferrata"
        ],
        [
          "has",
          "via_ferrata_scale"
        ]
