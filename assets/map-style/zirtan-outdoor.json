{
  "version": 8,
  "name": "Zirtan Outdoor",
  "metadata": {
    "zirtan:version": 1,
    "zirtan:doc": "Doğa temalı vektör stil. Renkler '@token' göstergeleriyle yazılır ve çalışma anında (src/features/maps/vector/style.ts → resolveMapStyle) tema varyantından çözülür. Kaynak adı '@source', karo katmanları OSM etiketlerini olduğu gibi taşır (highway, sac_scale, surface, natural, landuse, waterway, tourism, amenity).",
    "zirtan:sourceLayers": [
      "trails",
      "roads",
      "water",
      "landuse",
      "poi",
      "contours"
    ],
