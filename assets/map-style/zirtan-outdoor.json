  "sources": {},
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "@land"
      }
    },
    {
      "id": "landuse-forest",
      "type": "fill",
      "source": "@source",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "landuse"
          ],
          "forest"
        ],
        [
          "==",
          [
            "get",
            "natural"
          ],
          "wood"
        ]
      ],
      "paint": {
        "fill-color": "@forest",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse-scrub",
      "type": "fill",
      "source": "@source",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "in",
        [
          "get",
          "natural"
        ],
        [
          "literal",
          [
            "scrub",
            "grassland"
          ]
        ]
      ],
      "paint": {
        "fill-color": "@scrub",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse-rock",
      "type": "fill",
      "source": "@source",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "in",
        [
          "get",
          "natural"
        ],
        [
          "literal",
          [
            "bare_rock",
            "scree"
          ]
        ]
      ],
      "paint": {
        "fill-color": "@rock",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse-glacier",
      "type": "fill",
      "source": "@source",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": [
        "==",
        [
          "get",
          "natural"
        ],
        "glacier"
      ],
      "paint": {
        "fill-color": "@glacier"
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "@source",
      "source-layer": "water",
      "minzoom": 7,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "@water"
      }
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "@source",
      "source-layer": "water",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "@waterLine",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          12,
          1.4,
          15,
          3
        ]
      }
    },
    {
      "id": "contour-line",
      "type": "line",
      "source": "@source",
      "source-layer": "contours",
      "minzoom": 12,
      "paint": {
        "line-color": "@contour",
        "line-width": [
          "case",
          [
            "==",
            [
              "%",
              [
                "to-number",
                [
                  "get",
                  "ele"
                ],
                0
              ],
              100
            ],
            0
          ],
          0.9,
          0.45
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "@source",
      "source-layer": "roads",
      "minzoom": 8,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "@roadCasing",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          8,
          1.6,
          12,
          4.5,
          16,
          12
        ]
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "@source",
      "source-layer": "roads",
      "minzoom": 9,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "@road",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          9,
          0.7,
          12,
          2.6,
          16,
          8
        ]
      }
    },
    {
      "id": "trail-track",
      "type": "line",
      "source": "@source",
      "source-layer": "trails",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "highway"
        ],
        "track"
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "surface"
          ],
          [
            "asphalt",
            "paved",
            "concrete"
          ],
          "@surfPaved",
          [
            "rock",
            "bare_rock"
          ],
          "@surfRock",
          "@trailTrack"
        ],
        "line-dasharray": [
          4,
          1.5
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          9,
          0.9,
          13,
          2.4,
          16,
          5
        ]
      }
    },
    {
      "id": "trail-path",
      "type": "line",
      "source": "@source",
      "source-layer": "trails",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "in",
          [
            "get",
            "highway"
          ],
          [
            "literal",
            [
              "path",
              "footway",
              "bridleway",
              "cycleway"
            ]
          ]
        ],
        [
          "!",
          [
            "in",
            [
              "get",
              "sac_scale"
            ],
            [
              "literal",
              [
                "demanding_mountain_hiking",
                "alpine_hiking",
                "demanding_alpine_hiking",
                "difficult_alpine_hiking"
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "surface"
          ],
          [
            "gravel",
            "fine_gravel",
            "compacted",
            "pebblestone"
          ],
          "@surfGravel",
          [
            "asphalt",
            "paved",
            "concrete"
          ],
          "@surfPaved",
          [
            "rock",
            "bare_rock"
          ],
          "@surfRock",
          [
            "scree",
            "shingle"
          ],
          "@surfScree",
          [
            "snow",
            "ice"
          ],
          "@surfSnow",
          "@surfTrail"
        ],
        "line-dasharray": [
          3,
          1.2
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          9,
          0.8,
          13,
          2.2,
          16,
          4.5
        ]
      }
    },
